RewriteEngine On

# Deny direct access to PHP internals — only the entry scripts below (and
# their rewrite targets) are meant to be reachable.
RewriteRule ^php/lib/ - [F,L]

# Preserve the site's existing URL scheme: these routes used to be handled
# by Astro server endpoints / pages; now they're plain PHP files under
# php/, reached through the same paths so nothing else in the site (forms,
# links, docs) needed to change.
RewriteRule ^api/endorse/?$ php/endorse.php [L]
RewriteRule ^api/admin/moderate/?$ php/admin/moderate.php [L]
RewriteRule ^api/admin/edit/?$ php/admin/edit-submit.php [L]
RewriteRule ^api/admin/delete/?$ php/admin/delete.php [L]
RewriteRule ^api/endorsements/?$ php/endorsements.php [L]
RewriteRule ^admin/([0-9]+)/?$ php/admin/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/?$ php/admin/endorsements.php [L]

# Same security headers src/middleware.ts used to set on every response.
# Applies to static files and PHP responses alike (mod_headers operates on
# the outgoing HTTP response regardless of origin).
#
# The CSP's script-src carries a placeholder token (see scripts/inject-csp-hashes.mjs
# for its literal spelling) that the "Hash inline scripts for CSP" step in
# .github/workflows/deploy.yml fills in with a 'sha256-...' allowlist entry
# per distinct inline <script> body found across dist/ — src/middleware.ts
# used to cover this with a per-request nonce, which isn't possible once the
# HTML is static and built once in CI. Left as a literal token here (harmless
# — an unmatched CSP source, not a syntax error) if this .htaccess is ever
# served without going through that step, e.g. `astro build` run standalone;
# inline scripts just won't execute in that case.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}} https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'"
</IfModule>
