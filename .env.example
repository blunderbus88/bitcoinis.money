# Copy this file to .env and fill in real values.
# Never commit .env.
#
# This is build-time config for the static Astro site only. Runtime config
# for the dynamic parts (signature submission + admin moderation, served by
# public/php/*.php) lives in config.php — see config.php.example.

# --- Site ---
# Canonical public URL, used for share links and Open Graph tags.
SITE_URL=https://bitcoinis.money

# --- Cloudflare Turnstile (public site key only) ---
# https://developers.cloudflare.com/turnstile/
# This is the public site key, safe to embed in the static /endorse page at
# build time. The secret key (used for server-side verification) lives in
# config.php instead — see config.php.example.
TURNSTILE_SITE_KEY=
