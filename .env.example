# Copy this file to .env and fill in real values.
# Never commit .env — secrets must only come from the environment.

# --- Site ---
# Canonical public URL, used for share links and Open Graph tags.
SITE_URL=https://bitcoinis.money

# --- Database ---
# Path to the SQLite database file (signatures only — Principles content
# lives in Principles.md / content/, not the database).
DATABASE_PATH=./database/signatures.db

# --- Admin moderation ---
# HTTP Basic Auth credentials protecting /admin/*.
# Use a long, random password. Do not reuse this password elsewhere.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-value

# --- Abuse prevention ---
# Random string used to salt hashed IP addresses stored for rate-limiting.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-random-value

# --- Cloudflare Turnstile ---
# https://developers.cloudflare.com/turnstile/
# If left unset, Turnstile verification is skipped (development only —
# the server logs a warning). Both must be set in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
