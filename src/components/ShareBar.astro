---
import XIcon from './XIcon.astro';
import GitHubIcon from './GitHubIcon.astro';
import { tweetIntent } from '../lib/share';

interface Props {
  canonicalUrl: string;
  shareTextFull: string;
  shareTextBrief: string;
  sourceUrl?: string;
  sourceLabel?: string;
}

const {
  canonicalUrl,
  shareTextFull,
  shareTextBrief,
  sourceUrl,
  sourceLabel = 'View source',
} = Astro.props;

// shareTextFull is the raw document text and doesn't include the link, so it's
// appended via the `url` param. shareTextBrief already ends with the link
// inline, so passing `url` too would duplicate it in the tweet.
const tweetUrlFull = tweetIntent(shareTextFull, canonicalUrl);
const tweetUrlBrief = tweetIntent(shareTextBrief);
---

<div class="share-bar">
  {
    sourceUrl && (
      <a class="github-source-btn" href={sourceUrl} rel="noopener">
        <GitHubIcon class="github-icon" />
        <span>{sourceLabel}</span>
      </a>
    )
  }
  <details class="share-x">
    <summary class="x-share-btn"><XIcon class="x-icon" /><span>Share on X</span></summary>
    <div class="share-x-menu">
      <a href={tweetUrlFull} rel="noopener" target="_blank">Full text</a>
      <a href={tweetUrlBrief} rel="noopener" target="_blank">Brief description</a>
    </div>
  </details>
</div>

<script>
  document.querySelectorAll('details.share-x').forEach((details) => {
    details.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => details.removeAttribute('open'));
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll('details.share-x[open]').forEach((details) => {
      if (!details.contains(event.target as Node)) details.removeAttribute('open');
    });
  });
</script>
