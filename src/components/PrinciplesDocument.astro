---
import ShareBar from './ShareBar.astro';
import TerminologyNote from './TerminologyNote.astro';
import type { RenderedPrinciples } from '../lib/principles';

interface Props {
  doc: RenderedPrinciples;
  isCurrent: boolean;
  sourceUrl: string;
  canonicalUrl: string;
}

const { doc, isCurrent, sourceUrl, canonicalUrl } = Astro.props;

const shareTextBrief = `The White Paper explained how Bitcoin works. These Principles state what we believe Bitcoin is, why it matters, and what must endure.

${canonicalUrl}`;

const shareTextFull = doc.plainText;
---

<div class="page-shell">
  <p class="doc-relationship">
    <strong>Principles</strong> — the technical, monetary, and philosophical foundations we believe define Bitcoin
    and are worth defending. See also the <a href="/whitepaper">White Paper</a> — how Bitcoin works.
  </p>
</div>

{
  !isCurrent && (
    <div class="page-shell">
      <p class="archive-banner">
        You are viewing an archived version (v{doc.version}), preserved exactly as published.{' '}
        <a href="/principles">View the current version →</a>
      </p>
    </div>
  )
}

<ShareBar
  canonicalUrl={canonicalUrl}
  shareTextFull={shareTextFull}
  shareTextBrief={shareTextBrief}
  sourceUrl={sourceUrl}
/>

<TerminologyNote />

<article class="reading-column principles-body" set:html={doc.htmlBeginner} />

<div class="principles-sign-cta">
  <a class="btn btn-primary" href="/endorse">Endorse</a>
</div>

<div class="page-shell">
  <details class="endorsements-fan">
    <summary id="principles-ledger-summary">Endorsements</summary>
    <p id="principles-ledger-empty" hidden>No approved endorsements yet.</p>
    <ul class="ledger-list" id="principles-ledger-list"></ul>
  </details>
</div>

<script>
  import { loadLedger } from '../lib/renderLedger.client';

  const listEl = document.getElementById('principles-ledger-list');
  const summaryEl = document.getElementById('principles-ledger-summary');
  const emptyEl = document.getElementById('principles-ledger-empty');
  if (listEl && summaryEl) {
    loadLedger(listEl, (total) => {
      summaryEl.textContent = `${total} endorsement${total === 1 ? '' : 's'}`;
      if (total === 0) emptyEl?.removeAttribute('hidden');
    });
  }
</script>

<style>
  .principles-body {
    max-width: 80ch;
  }

  .principles-sign-cta {
    display: flex;
    justify-content: center;
    margin: 2.5rem auto;
    max-width: var(--measure);
  }

  .doc-relationship {
    max-width: var(--measure);
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .doc-relationship a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }

  .archive-banner {
    background: var(--btc-orange-tint);
    border: 1px solid var(--btc-orange);
    border-radius: var(--radius);
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    margin: 2rem auto 0;
    max-width: var(--measure);
  }

  .endorsements-fan {
    max-width: var(--measure);
    margin: 1.5rem auto 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.9rem 1.25rem;
    background: var(--color-bg-subtle);
  }

  .endorsements-fan summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .endorsements-fan .ledger-list {
    margin-top: 1rem;
  }
</style>
