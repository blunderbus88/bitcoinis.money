---
import ShareBar from './ShareBar.astro';
import TerminologyNote from './TerminologyNote.astro';
import type { RenderedPrinciples } from '../lib/principles';

interface Props {
  doc: RenderedPrinciples;
  isCurrent: boolean;
  sourceUrl: string;
  canonicalUrl: string;
}

const { doc, isCurrent, sourceUrl, canonicalUrl } = Astro.props;

const shareTextBrief = `The White Paper explained how Bitcoin works. These Principles state what we believe Bitcoin is, why it matters, and what must endure.

${canonicalUrl}`;

const shareTextFull = doc.plainText;
---

<div class="doc-relationship page-shell">
  <p>
    <strong>Principles</strong> — what we believe is worth preserving. See also the <a href="/whitepaper">White Paper</a> — how
    Bitcoin works.
  </p>
</div>

{
  !isCurrent && (
    <div class="page-shell">
      <p class="archive-banner">
        You are viewing an archived version (v{doc.version}), preserved exactly as published.{' '}
        <a href="/principles">View the current version →</a>
      </p>
    </div>
  )
}

<ShareBar
  canonicalUrl={canonicalUrl}
  shareTextFull={shareTextFull}
  shareTextBrief={shareTextBrief}
  sourceUrl={sourceUrl}
/>

<TerminologyNote />

<article class="reading-column principles-body" set:html={doc.htmlBeginner} />

<div class="principles-sign-cta">
  <a class="btn btn-primary" href="/endorse">Endorse</a>
</div>

<style>
  .principles-body {
    max-width: 80ch;
  }

  .principles-sign-cta {
    display: flex;
    justify-content: center;
    margin: 2.5rem auto;
    max-width: var(--measure);
  }

  .doc-relationship {
    max-width: var(--measure);
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .doc-relationship a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }

  .archive-banner {
    background: var(--btc-orange-tint);
    border: 1px solid var(--btc-orange);
    border-radius: var(--radius);
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    margin: 2rem auto 0;
    max-width: var(--measure);
  }
</style>
