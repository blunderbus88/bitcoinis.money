---
import DocMeta from './DocMeta.astro';
import ShareBar from './ShareBar.astro';
import TerminologyNote from './TerminologyNote.astro';
import type { RenderedPrinciples } from '../lib/principles';

interface Props {
  doc: RenderedPrinciples;
  isCurrent: boolean;
  sourceUrl: string;
  markdownUrl: string;
  canonicalUrl: string;
}

const { doc, isCurrent, sourceUrl, markdownUrl, canonicalUrl } = Astro.props;

const shareText =
  'Bitcoin is more than consensus code. These Principles attempt to state plainly what Bitcoin is, what makes it worth preserving, and what responsibilities come with carrying it forward.';
---

{
  !isCurrent && (
    <div class="page-shell">
      <p class="archive-banner">
        You are viewing an archived version (v{doc.version}), preserved exactly as published.{' '}
        <a href="/principles">View the current version →</a>
      </p>
    </div>
  )
}

<DocMeta
  version={doc.version}
  publishedAt={doc.publishedAt}
  hash={doc.hash}
  sourceUrl={sourceUrl}
  markdownUrl={markdownUrl}
  showBeginnerToggle={true}
/>

<TerminologyNote />

<ShareBar canonicalUrl={canonicalUrl} markdownUrl={markdownUrl} shareText={shareText} />

<article class="reading-column principles-body" set:html={doc.htmlBeginner} />

<style>
  .principles-body {
    max-width: 80ch;
  }

  .archive-banner {
    background: var(--btc-orange-tint);
    border: 1px solid var(--btc-orange);
    border-radius: var(--radius);
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    margin: 2rem auto 0;
    max-width: var(--measure);
  }
</style>
