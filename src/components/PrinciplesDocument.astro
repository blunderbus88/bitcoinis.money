---
import ShareBar from './ShareBar.astro';
import TerminologyNote from './TerminologyNote.astro';
import type { RenderedPrinciples } from '../lib/principles';
import { listApprovedSignatures, countApprovedSignatures, parseParticipantTypes } from '../lib/db';

interface Props {
  doc: RenderedPrinciples;
  isCurrent: boolean;
  sourceUrl: string;
  canonicalUrl: string;
}

const { doc, isCurrent, sourceUrl, canonicalUrl } = Astro.props;

const signatures = listApprovedSignatures();
const totalEndorsements = countApprovedSignatures();

const shareTextBrief = `The White Paper explained how Bitcoin works. These Principles state what we believe Bitcoin is, why it matters, and what must endure.

${canonicalUrl}`;

const shareTextFull = doc.plainText;
---

<div class="page-shell">
  <p class="doc-relationship">
    <strong>Principles</strong> — the technical, monetary, and philosophical foundations we believe define Bitcoin
    and are worth defending. See also the <a href="/whitepaper">White Paper</a> — how Bitcoin works.
  </p>
</div>

{
  !isCurrent && (
    <div class="page-shell">
      <p class="archive-banner">
        You are viewing an archived version (v{doc.version}), preserved exactly as published.{' '}
        <a href="/principles">View the current version →</a>
      </p>
    </div>
  )
}

<ShareBar
  canonicalUrl={canonicalUrl}
  shareTextFull={shareTextFull}
  shareTextBrief={shareTextBrief}
  sourceUrl={sourceUrl}
/>

<TerminologyNote />

<article class="reading-column principles-body" set:html={doc.htmlBeginner} />

<div class="principles-sign-cta">
  <a class="btn btn-primary" href="/endorse">Endorse</a>
</div>

<div class="page-shell">
  <details class="endorsements-fan">
    <summary>{totalEndorsements} endorsement{totalEndorsements === 1 ? '' : 's'}</summary>
    {signatures.length === 0 && <p>No approved endorsements yet.</p>}
    <ul class="ledger-list">
      {
        signatures.map((sig) => (
          <li class="ledger-item">
            <div>
              <div class="ledger-name">{sig.name}</div>
              <div class="ledger-meta">
                v{sig.principles_version} ·{' '}
                {new Date(sig.moderated_at ?? sig.created_at).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
                {sig.website && (
                  <>
                    {' · '}
                    <a href={sig.website} rel="noopener nofollow">
                      website
                    </a>
                  </>
                )}
                {sig.github && (
                  <>
                    {' · '}
                    <a href={sig.github} rel="noopener nofollow">
                      GitHub
                    </a>
                  </>
                )}
                {sig.x_profile && (
                  <>
                    {' · '}
                    <a href={sig.x_profile} rel="noopener nofollow">
                      X
                    </a>
                  </>
                )}
              </div>
              {sig.comment && <div class="ledger-comment">“{sig.comment}”</div>}
            </div>
            <span class="ledger-types">
              {parseParticipantTypes(sig.participant_type).map((t) => (
                <span class="ledger-type">{t}</span>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
  </details>
</div>

<style>
  .principles-body {
    max-width: 80ch;
  }

  .principles-sign-cta {
    display: flex;
    justify-content: center;
    margin: 2.5rem auto;
    max-width: var(--measure);
  }

  .doc-relationship {
    max-width: var(--measure);
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .doc-relationship a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }

  .archive-banner {
    background: var(--btc-orange-tint);
    border: 1px solid var(--btc-orange);
    border-radius: var(--radius);
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    margin: 2rem auto 0;
    max-width: var(--measure);
  }

  .endorsements-fan {
    max-width: var(--measure);
    margin: 1.5rem auto 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.9rem 1.25rem;
    background: var(--color-bg-subtle);
  }

  .endorsements-fan summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .endorsements-fan .ledger-list {
    margin-top: 1rem;
  }
</style>
