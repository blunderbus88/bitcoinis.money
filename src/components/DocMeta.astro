---
interface Props {
  version: string;
  publishedAt: string;
  hash: string;
  sourceUrl: string;
  markdownUrl: string;
  showBeginnerToggle?: boolean;
}

const { version, publishedAt, hash, sourceUrl, markdownUrl, showBeginnerToggle = false } = Astro.props;

const shortHash = hash.length > 16 ? `${hash.slice(0, 16)}…` : hash;
const dateLabel = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'Not yet released';
---

<div class="doc-meta">
  <div class="doc-meta-card">
    <dl class="doc-meta-facts">
      <dt>Version</dt>
      <dd>{version}</dd>
      <dt>Published</dt>
      <dd>{dateLabel}</dd>
      <dt>BLAKE2b</dt>
      <dd title={hash}>{shortHash}</dd>
    </dl>
    <div class="doc-meta-actions">
      {
        showBeginnerToggle && (
          <label class="beginner-toggle" for="beginner-toggle">
            <input type="checkbox" id="beginner-toggle" />
            <span class="switch-track"><span class="switch-thumb" /></span>
            Beginner explanations: <span class="js-toggle-state">Off</span>
          </label>
        )
      }
      <div class="link-row">
        <a href="#" data-copy-hash={hash}>Copy hash</a>
        <a href={markdownUrl} download>Download .md</a>
        <a href={sourceUrl} rel="noopener">View source</a>
        <a href="#" data-action="print">Print</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Progressive enhancement only. The Beginner Mode toggle already works via
  // pure CSS/HTML (the checkbox-hack in global.css); this script just
  // persists the preference across page loads and updates the on-screen
  // "Off/On" label, and wires up small convenience actions.
  const toggle = document.getElementById('beginner-toggle') as HTMLInputElement | null;
  const stateLabel = document.querySelector('.js-toggle-state');

  function syncLabel() {
    if (stateLabel && toggle) stateLabel.textContent = toggle.checked ? 'On' : 'Off';
  }

  if (toggle) {
    const stored = localStorage.getItem('beginnerMode');
    if (stored === 'on') toggle.checked = true;
    syncLabel();

    toggle.addEventListener('change', () => {
      localStorage.setItem('beginnerMode', toggle.checked ? 'on' : 'off');
      syncLabel();
    });
  }

  document.querySelectorAll('[data-action="print"]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      window.print();
    });
  });

  async function copyText(text: string): Promise<boolean> {
    if (navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // fall through to the execCommand fallback below
      }
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  document.querySelectorAll('[data-copy-hash]').forEach((el) => {
    el.addEventListener('click', async (e) => {
      e.preventDefault();
      const hash = el.getAttribute('data-copy-hash');
      if (!hash) return;
      const ok = await copyText(hash);
      const original = el.textContent;
      el.textContent = ok ? 'Copied' : 'Copy failed';
      setTimeout(() => {
        el.textContent = original;
      }, 1500);
    });
  });
</script>
