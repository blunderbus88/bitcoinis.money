---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listApprovedSignatures, countApprovedSignatures } from '../lib/db';
import { PARTICIPANT_TYPES } from '../lib/validation';

const filter = Astro.url.searchParams.get('type');
const activeType = filter && (PARTICIPANT_TYPES as readonly string[]).includes(filter) ? filter : 'All';

const signatures = listApprovedSignatures(activeType);
const total = countApprovedSignatures();
---

<BaseLayout
  title="Signatures"
  description="People who have voluntarily endorsed a specific version of Our Bitcoin Principles."
>
  <div class="reading-column">
    <h1>Signatures</h1>
    <p>
      A restrained ledger of voluntary personal endorsements — not a leaderboard. Each entry is tied to the exact
      Principles version its signer endorsed; see <a href="/principles/versions">the version archive</a>.
    </p>

    <div class="ledger-toolbar">
      <span class="ledger-count">{total} signature{total === 1 ? '' : 's'}</span>
      <nav class="ledger-filter" aria-label="Filter by participant type">
        <a href="/signatures" aria-current={activeType === 'All' ? 'true' : undefined}>All</a>
        {
          PARTICIPANT_TYPES.map((t) => (
            <a href={`/signatures?type=${encodeURIComponent(t)}`} aria-current={activeType === t ? 'true' : undefined}>
              {t}
            </a>
          ))
        }
      </nav>
    </div>

    {signatures.length === 0 && <p>No approved signatures yet in this category.</p>}

    <ul class="ledger-list">
      {
        signatures.map((sig) => (
          <li class="ledger-item">
            <div>
              <div class="ledger-name">{sig.name}</div>
              <div class="ledger-meta">
                v{sig.principles_version} ·{' '}
                {new Date(sig.moderated_at ?? sig.created_at).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
                {sig.website && (
                  <>
                    {' · '}
                    <a href={sig.website} rel="noopener nofollow">
                      website
                    </a>
                  </>
                )}
                {sig.github && (
                  <>
                    {' · '}
                    <a href={sig.github} rel="noopener nofollow">
                      GitHub
                    </a>
                  </>
                )}
                {sig.x_profile && (
                  <>
                    {' · '}
                    <a href={sig.x_profile} rel="noopener nofollow">
                      X
                    </a>
                  </>
                )}
              </div>
              {sig.comment && <div class="ledger-comment">“{sig.comment}”</div>}
            </div>
            <span class="ledger-type">{sig.participant_type}</span>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
