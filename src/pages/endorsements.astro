---
// This page is static output — the live signature list is fetched
// client-side from /api/endorsements (public/php/endorsements.php), since
// this site has no per-request server to render it directly (see
// deploy/SITEGROUND_DEPLOY.md). Rendering itself lives in
// src/lib/renderLedger.client.ts, shared with the inline endorsements
// widget on the Principles page.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Endorsements"
  description="People who have voluntarily endorsed a specific version of Our Bitcoin Principles."
>
  <div class="reading-column">
    <h1>Endorsements</h1>
    <p>
      A restrained ledger of voluntary personal endorsements — not a leaderboard. Each entry is tied to the exact
      Principles version its endorser affirmed.
    </p>

    <p class="ledger-count" id="ledger-count">Loading…</p>

    <p id="ledger-empty" hidden>No approved endorsements yet.</p>

    <ul class="ledger-list" id="ledger-list"></ul>
  </div>

  <script>
    import { loadLedger } from '../lib/renderLedger.client';

    const listEl = document.getElementById('ledger-list');
    const countEl = document.getElementById('ledger-count');
    const emptyEl = document.getElementById('ledger-empty');
    if (listEl && countEl) {
      loadLedger(listEl, (total) => {
        countEl.textContent = `${total} endorsement${total === 1 ? '' : 's'}`;
        if (total === 0) emptyEl?.removeAttribute('hidden');
      });
    }
  </script>
</BaseLayout>
