---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrinciplesDocument from '../../components/PrinciplesDocument.astro';
import { getPrinciplesVersion, isCurrentVersion, listVersions } from '../../lib/principles';
import { validateVersion } from '../../lib/validation';

// Static output needs every version's path known at build time — there's
// no per-request server left to resolve arbitrary :version values.
export const getStaticPaths: GetStaticPaths = () =>
  listVersions().map((v) => ({ params: { version: v.version } }));

const versionParam = validateVersion(Astro.params.version);
if (!versionParam) {
  return new Response('Not found', { status: 404 });
}

const doc = getPrinciplesVersion(versionParam);
if (!doc) {
  return new Response('Not found', { status: 404 });
}

const current = isCurrentVersion(versionParam);
const siteUrl = import.meta.env.SITE_URL || 'https://bitcoinis.money';
const sourceUrl = `https://github.com/blunderbus88/bitcoinis.money/blob/main/content/principles-archive/v${doc.version}.md`;
---

<BaseLayout
  title={`Principles v${doc.version}`}
  description={`Our Bitcoin Principles, version ${doc.version} — preserved exactly as published, hash-pinned for verification.`}
  current="principles"
>
  <PrinciplesDocument
    doc={doc}
    isCurrent={current}
    sourceUrl={sourceUrl}
    canonicalUrl={new URL(`/principles/${doc.version}`, siteUrl).toString()}
  />
</BaseLayout>
