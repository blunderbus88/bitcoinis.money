---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWhitePaperHtml } from '../lib/whitepaper';

const html = getWhitePaperHtml();
---

<BaseLayout
  title="White Paper"
  description="Bitcoin: A Peer-to-Peer Electronic Cash System — the original white paper by Satoshi Nakamoto, hosted in full."
  current="whitepaper"
>
  <div class="page-shell">
    <p class="doc-relationship">
      <strong>White Paper</strong> — Satoshi Nakamoto's technical explanation of how Bitcoin enables peer-to-peer
      electronic cash.
    </p>
  </div>

  <div class="doc-divider"></div>

  <article class="reading-column whitepaper-body" set:html={html} />
</BaseLayout>

<style>
  .whitepaper-body {
    max-width: 80ch;
  }

  .doc-relationship {
    max-width: var(--measure);
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .doc-relationship a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }

  .doc-divider {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
</style>
