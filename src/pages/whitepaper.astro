---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareBar from '../components/ShareBar.astro';
import { getWhitePaperHtml, getWhitePaperMarkdown } from '../lib/whitepaper';
import { markdownToPlainText } from '../lib/markdown';

const html = getWhitePaperHtml();
const siteUrl = import.meta.env.SITE_URL || 'https://bitcoinis.money';
const canonicalUrl = new URL('/whitepaper', siteUrl).toString();

const shareTextBrief = `Bitcoin: A Peer-to-Peer Electronic Cash System — the original white paper by Satoshi Nakamoto.

${canonicalUrl}`;

const shareTextFull = markdownToPlainText(getWhitePaperMarkdown());
---

<BaseLayout
  title="White Paper"
  description="Bitcoin: A Peer-to-Peer Electronic Cash System — the original white paper by Satoshi Nakamoto, hosted in full."
  current="whitepaper"
>
  <div class="doc-relationship page-shell">
    <p>
      <strong>White Paper</strong> — Satoshi Nakamoto's technical explanation of how Bitcoin enables peer-to-peer
      electronic cash.
    </p>
  </div>

  <ShareBar
    canonicalUrl={canonicalUrl}
    shareTextFull={shareTextFull}
    shareTextBrief={shareTextBrief}
  />

  <article class="reading-column whitepaper-body" set:html={html} />
</BaseLayout>

<style>
  .whitepaper-body {
    max-width: 80ch;
  }

  .doc-relationship {
    max-width: var(--measure);
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .doc-relationship a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }
</style>
