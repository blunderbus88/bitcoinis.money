---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentPrinciples } from '../lib/principles';
import { PARTICIPANT_TYPES } from '../lib/validation';
import { turnstileSiteKey } from '../lib/turnstile';

const doc = getCurrentPrinciples();
const siteKey = turnstileSiteKey();

const errorCode = Astro.url.searchParams.get('error');
const submitted = Astro.url.searchParams.get('submitted') === '1';

const ERROR_MESSAGES: Record<string, string> = {
  validation: 'Please check the highlighted fields and try again.',
  challenge: 'The anti-spam challenge could not be verified. Please try again.',
  rate_limited: 'Too many submissions from this connection recently. Please try again later.',
  version: 'The Principles were updated while you were filling this out. Please reload and sign the current version.',
  unknown: 'Something went wrong submitting your signature. Please try again.',
};
---

<BaseLayout
  title="Sign the Principles"
  description="Add your voluntary personal endorsement of the current version of Our Bitcoin Principles."
  current="sign"
>
  <div class="reading-column">
    <h1>Sign the Principles</h1>

    <p class="form-note">
      Signing affirms only that you personally endorse these Principles. It grants no membership, authority, or
      special status. You are not required to use your real name, and you do not need a GitHub account. Submissions
      are reviewed before appearing publicly.
    </p>

    {!doc && (
      <p class="form-error">No version of the Principles has been published yet, so signing isn't open.</p>
    )}

    {submitted && (
      <p class="form-success">
        Thank you — your signature has been recorded and is pending review. Approved signatures appear on the
        <a href="/signatures">signature ledger</a>.
      </p>
    )}

    {errorCode && <p class="form-error">{ERROR_MESSAGES[errorCode] ?? ERROR_MESSAGES.unknown}</p>}

    {doc && (
      <form method="POST" action="/api/sign" class="form-grid">
        <input type="hidden" name="principles_version" value={doc.version} />
        <input type="hidden" name="principles_hash" value={doc.hash} />

        <div class="form-field">
          <label for="name">Name or pseudonym</label>
          <input type="text" id="name" name="name" maxlength="100" required />
        </div>

        <div class="form-field">
          <label for="participant_type">Participant type</label>
          <select id="participant_type" name="participant_type" required>
            <option value="" disabled selected>
              Choose one
            </option>
            {PARTICIPANT_TYPES.map((t) => (
              <option value={t}>{t}</option>
            ))}
          </select>
        </div>

        <div class="form-field">
          <label for="website">Website <span class="hint">(optional)</span></label>
          <input type="url" id="website" name="website" placeholder="https://" maxlength="300" />
        </div>

        <div class="form-field">
          <label for="github">GitHub <span class="hint">(optional — username or profile URL)</span></label>
          <input type="text" id="github" name="github" placeholder="satoshi" maxlength="120" />
        </div>

        <div class="form-field">
          <label for="x_profile">X <span class="hint">(optional — @handle or profile URL)</span></label>
          <input type="text" id="x_profile" name="x_profile" placeholder="@handle" maxlength="120" />
        </div>

        <div class="form-field">
          <label for="nostr">Nostr <span class="hint">(optional — npub…)</span></label>
          <input type="text" id="nostr" name="nostr" placeholder="npub1…" maxlength="120" />
        </div>

        <div class="form-field">
          <label for="comment">Comment <span class="hint">(optional, 280 characters)</span></label>
          <textarea id="comment" name="comment" maxlength="280"></textarea>
        </div>

        {siteKey && (
          <div class="form-field">
            <div class="cf-turnstile" data-sitekey={siteKey}></div>
          </div>
        )}

        <div>
          <button type="submit" class="btn btn-primary">Sign the Principles</button>
        </div>
      </form>
    )}

    {doc && (
      <p class="version-pin-note">
        You are signing <strong>Principles v{doc.version}</strong> · BLAKE2b <code>{doc.hash.slice(0, 16)}…</code>. If
        a newer version is published later, your signature stays tied to this exact text — it is never carried
        forward automatically.
      </p>
    )}
  </div>

  {siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</BaseLayout>

<style>
  .version-pin-note {
    color: var(--color-text-faint);
    font-size: 0.85rem;
    margin-top: 2rem;
  }
</style>
