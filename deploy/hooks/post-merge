#!/bin/sh
# Runs after every `git pull` in this repo on the SiteGround server (Site
# Tools' Git tool does a plain pull into a working copy, so a standard git
# hook is the right place to build). Not executed anywhere else.
#
# Install once, after Site Tools' Git tool has done its first clone:
#   ln -sf ../../deploy/hooks/post-merge .git/hooks/post-merge
#   chmod +x .git/hooks/post-merge deploy/hooks/post-merge
set -e
cd "$(dirname "$0")/../.."
REPO_ROOT="$(pwd)"

npm ci
npm run build

# public/php/admin/.htaccess ships with a {{REPO_ROOT}} placeholder (Apache's
# AuthUserFile needs an absolute path, and this repo's checkout location
# varies by environment) — substitute the real path into the built copy on
# every deploy, since dist/ is regenerated from scratch each time.
sed -i "s#{{REPO_ROOT}}#${REPO_ROOT}#g" dist/php/admin/.htaccess

# Static files + PHP are served directly by Apache/PHP-FPM — no process to
# restart (this account has no Node.js App Manager / Passenger; see
# deploy/SITEGROUND_DEPLOY.md).
